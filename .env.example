# Public Vite settings, embedded in the browser bundle at build time.
# Leave sales closed until every release check in docs/digital-products-launch.md
# is complete. Never put API keys, webhook secrets, or download URLs here.
VITE_BUDGET_RELEASE_READY=false
VITE_BUDGET_CHECKOUT_URL=/api/store/checkout
VITE_BUDGET_PRICE_USD=9

VITE_DASHBOARD_RELEASE_READY=false
VITE_DASHBOARD_CHECKOUT_URL=/api/store/checkout
VITE_DASHBOARD_PRICE_USD=29
# Leave false unless GA4 Enhanced Measurement history pageviews are disabled.
# Automatic pageviews remain the default to avoid duplicate SPA view events.
VITE_GA_MANUAL_PAGEVIEWS=false
